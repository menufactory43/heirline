{
  "name": "heirline",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n serveur,client \"npm:dev:server\" \"npm:dev:client\"",
    "dev:server": "tsx watch server/main.ts",
    "dev:client": "vite --host 0.0.0.0 --port 5190",
    "build": "vite build",
    "start": "vite build && NODE_ENV=production tsx server/main.ts",
    "serve": "NODE_ENV=production tsx server/main.ts",
    "typecheck": "tsc --noEmit",
    "journaux": "tsx tools/journaux.ts",
    "test": "tsx --test tests/*.test.ts",
    "charge": "tsx tests/charge.ts",
    "vfx": "node vfx/generer.mjs && node vfx/construire.mjs"
  },
  "dependencies": {
    "@colyseus/schema": "^5.0.42",
    "@colyseus/sdk": "^0.18.8",
    "@colyseus/ws-transport": "^0.18.4",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "colyseus": "^0.18.10",
    "express": "^5.3.0",
    "phaser": "^4.2.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.6",
    "concurrently": "^10.0.6",
    "playwright-core": "^1.61.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.5"
  }
}
